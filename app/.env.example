# Supabase project settings (Project settings > API). The anon key is public-safe; never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Setup page email (server-side only; never prefix with VITE_). Set these in Vercel's Environment Variables.
RESEND_API_KEY=
SETUP_TO_EMAIL=
